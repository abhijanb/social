# Copy this file to `.env` and replace placeholders with real values.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Required — auth token signing secret, at least 32 chars. No default.
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
# Optional — auth token expiry. Defaults to 7d.
JWT_EXPIRES_IN="7d"

# Optional — server port (0-65535). Defaults to 3000.
PORT="3000"
# Optional — development | production | test. Defaults to development.
# SMTP_HOST is required when NODE_ENV=production.
NODE_ENV="development"

# Base URL of the frontend app (used in verification email links).
# Defaults to http://localhost:3000.
APP_URL="http://localhost:3000"

# SMTP (optional in development — mail send fails with 500 if unset;
# required in production). PORT defaults to 587, SECURE to false.
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Social <no-reply@localhost>"
