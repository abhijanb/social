{
  "name": "social",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["back", "front"],
  "scripts": {
    "dev": "concurrently -n back,front -c blue,green \"bun --cwd=back run dev\" \"bun --cwd=front run dev\"",
    "dev:back": "bun --cwd=back run dev",
    "dev:front": "bun --cwd=front run dev",
    "build": "bun --cwd=back run build && bun --cwd=front run build",
    "start": "bun --cwd=back run start",
    "lint": "bun --cwd=front run lint",
    "db:generate": "bun --cwd=back run db:generate",
    "db:migrate": "bun --cwd=back run db:migrate",
    "db:seed": "bun --cwd=back run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
